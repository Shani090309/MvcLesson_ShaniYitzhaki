@model MvcLesson_ShaniYitzhaki.Models.ClassRoom

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>ClassRoom</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="ClassName" class="control-label"></label>
                <input asp-for="ClassName" class="form-control" />
                <span asp-validation-for="ClassName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="control-label">Students</label>
                <div class="row">
                    @foreach (var student in ViewBag.AllStudents)
                    {
                        <div class="col-md-4">
                            <input type="checkbox" name="selectedStudents" value="@student.Id"
                                   @(Model.Students != null && Model.Students.Any(s => s.Id == student.Id) ? "checked" : "") />
                            @student.FirstName @student.LastName <br />
                        </div>
                    }
                </div>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
