@model IEnumerable<MvcLesson_ShaniYitzhaki.Models.ClassRoom>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>ClassName</th>
            <th>Students</th> 
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.ClassName)</td>

                <td>
                    @if (item.Students != null && item.Students.Any())
                    {
                        @string.Join(", ", item.Students.Select(s => s.FirstName + " " + s.LastName))
                    }
                    else
                    {
                        <span class="text-muted">No Students</span>
                    }
                </td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
