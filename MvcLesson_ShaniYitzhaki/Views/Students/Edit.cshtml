@model MvcLesson_ShaniYitzhaki.Models.Student

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Student</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="FirstName" class="control-label"></label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="LastName" class="control-label"></label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="GradeLevel" class="control-label"></label>
                <input asp-for="GradeLevel" class="form-control" />
                <span asp-validation-for="GradeLevel" class="text-danger"></span>
                <div class="form-group">
                    <label class="control-label">ClassRoom</label>
                    <select name="classRoomId" class="form-control" asp-items="@(new SelectList(ViewBag.AllClassRooms, "Id", "ClassName", Model.ClassRoomId))">
                        <option value="">-- Select ClassRoom --</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="control-label">Teachers</label>
                    <div class="row">
                        @foreach (var teacher in ViewBag.AllTeachers)
                        {
                            <div class="col-md-4">
                                <input type="checkbox" name="selectedTeachers" value="@teacher.Id"
                                       @(Model.Teachers.Any(t => t.Id == teacher.Id) ? "checked" : "") />
                                @teacher.Name <br />
                            </div>
                        }
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label">Courses</label>
                    <div class="row">
                        @foreach (var course in ViewBag.AllCourses)
                        {
                            <div class="col-md-4">
                                <input type="checkbox" name="selectedCourses" value="@course.Id"
                                       @(Model.Courses.Any(c => c.Id == course.Id) ? "checked" : "") />
                                @course.Title <br />
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
